{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Errand",
  "version": "0.3.0",
  "identifier": "com.errandai.errand",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "Errand",
        "width": 1280,
        "height": 820,
        "center": true,
        "minWidth": 640,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: http:; media-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "Developer ID Application: Wolfgang Gabler (L5VWNX44MY)",
      "hardenedRuntime": true,
      "entitlements": "Errand.entitlements",
      "providerShortName": "L5VWNX44MY"
    }
  }
}
